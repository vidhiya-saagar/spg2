# Copy this file to .env and fill in the values.
# .env is git-ignored; never commit real secrets.

# ── Rails ────────────────────────────────────────────────────────────────────
RAILS_ENV=development

# Required in production to decrypt config/credentials.yml.enc
# Run `bin/rails credentials:edit` to manage credentials.
RAILS_MASTER_KEY=

# Puma / server
PORT=1843
RAILS_MAX_THREADS=5

# ── Contentful CMS (optional) ────────────────────────────────────────────────
# Used by ContentfulPauriImporter and ContentfulTukImporter services.
# Leave blank if you are not importing footnotes from Contentful.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
